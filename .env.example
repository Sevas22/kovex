# Cadena de conexión de Supabase: Project Settings → Database → Connection string →
# "Transaction pooler" (puerto 6543). Reemplaza [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Firma de la sesión del panel admin. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# URL pública del sitio (se usa en los enlaces que viajan por WhatsApp).
NEXT_PUBLIC_SITE_URL=https://kovex.example.com
